  92:UserAPP/Source/ADCAPP.c **** /**
  93:UserAPP/Source/ADCAPP.c ****  * @brief 启动ADC DMA转换并等待完成
  94:UserAPP/Source/ADCAPP.c ****  * @return uint8_t 返回转换状态：0表示成功，非0表示失败
  95:UserAPP/Source/ADCAPP.c ****  */
  96:UserAPP/Source/ADCAPP.c **** uint8_t vADC_StartConversion(void) // ADC DMA转换函数
  97:UserAPP/Source/ADCAPP.c **** {
  98:UserAPP/Source/ADCAPP.c ****     adc_dma_complete = 0; // 清除完成标志
  99:UserAPP/Source/ADCAPP.c ****     
 100:UserAPP/Source/ADCAPP.c ****     /* 启动 DMA 转换，采样 11 个通道到 adcbuf */
 101:UserAPP/Source/ADCAPP.c ****     if (HAL_ADC_Start_DMA(&hadc1, adcbuf, 11) != HAL_OK) // 启动 DMA
 102:UserAPP/Source/ADCAPP.c ****     {
 103:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) { // 检查发送队列有效性
 104:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "ADC Start DMA Error\r\n"); // 发送错误信息
 105:UserAPP/Source/ADCAPP.c ****         }
 106:UserAPP/Source/ADCAPP.c ****         return 1; // 返回错误
 107:UserAPP/Source/ADCAPP.c ****     }
 108:UserAPP/Source/ADCAPP.c **** 
 109:UserAPP/Source/ADCAPP.c ****     /* 等待转换完成，增加超时机制（10ms足够11个通道转换） */
 110:UserAPP/Source/ADCAPP.c ****     uint32_t timeout = 10; // 超时计数 10ms
 111:UserAPP/Source/ADCAPP.c ****     while (adc_dma_complete == 0 && timeout > 0) // 等待完成标志或超时
 112:UserAPP/Source/ADCAPP.c ****     {
 113:UserAPP/Source/ADCAPP.c ****         vTaskDelay(pdMS_TO_TICKS(1)); // 挂起 1ms 避免独占 CPU
 114:UserAPP/Source/ADCAPP.c ****         timeout--; // 递减计数
 115:UserAPP/Source/ADCAPP.c ****     }
 116:UserAPP/Source/ADCAPP.c ****     
 117:UserAPP/Source/ADCAPP.c ****     HAL_ADC_Stop_DMA(&hadc1); // 停止 ADC DMA
 118:UserAPP/Source/ADCAPP.c **** 
 119:UserAPP/Source/ADCAPP.c ****     if (timeout == 0) // 检查是否超时
 120:UserAPP/Source/ADCAPP.c ****     {
 121:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) { // 检查发送队列有效性
 122:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "ADC DMA Timeout\r\n"); // 发送超时信息
 123:UserAPP/Source/ADCAPP.c ****         }
 124:UserAPP/Source/ADCAPP.c ****         return 2; // 返回超时错误
 125:UserAPP/Source/ADCAPP.c ****     }
 126:UserAPP/Source/ADCAPP.c ****     
 127:UserAPP/Source/ADCAPP.c ****     return 0; // 返回成功
 128:UserAPP/Source/ADCAPP.c **** }
 129:UserAPP/Source/ADCAPP.c **** 
 130:UserAPP/Source/ADCAPP.c **** 
 131:UserAPP/Source/ADCAPP.c **** 
 132:UserAPP/Source/ADCAPP.c **** /**
 133:UserAPP/Source/ADCAPP.c ****  * @brief 将ADC采样值转换为实际输入电压
 134:UserAPP/Source/ADCAPP.c ****  * @param adc_value: ADC采集到的数字值（0~4095）
 135:UserAPP/Source/ADCAPP.c ****  * @return 实际输入电压值，单位V（范围约-20.12~+20.12V）
 136:UserAPP/Source/ADCAPP.c ****  */
 137:UserAPP/Source/ADCAPP.c **** float adc_to_voltage(uint16_t adc_value) // 转换函数实现
 138:UserAPP/Source/ADCAPP.c **** {
 139:UserAPP/Source/ADCAPP.c ****     float adc_voltage = (float)adc_value * ADC_REF_VOLTAGE / ADC_RESOLUTION; // 计算引脚电压
 140:UserAPP/Source/ADCAPP.c ****     
 141:UserAPP/Source/ADCAPP.c ****     // 原始公式：V_in = (V_pin * LEVEL_SHIFT - V_ref) / DIV_RATIO
 142:UserAPP/Source/ADCAPP.c ****     float raw_voltage = ((adc_voltage * LEVEL_SHIFT_RATIO) - ADC_REF_VOLTAGE) / VOLTAGE_DIV_RATIO;
 143:UserAPP/Source/ADCAPP.c ****     
 144:UserAPP/Source/ADCAPP.c ****     // 不使用固定静态偏移，直接返回物理换算值。
 145:UserAPP/Source/ADCAPP.c ****     return raw_voltage;
 146:UserAPP/Source/ADCAPP.c **** }
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\cczzPua0.s 			page 4


