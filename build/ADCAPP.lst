 240:UserAPP/Source/ADCAPP.c ****     /* 将校准后电流数组按内存布局打包为字节流（小端float，44字节） */
 241:UserAPP/Source/ADCAPP.c ****     uint8_t current_data[sizeof(calibrated_current_array)];
 242:UserAPP/Source/ADCAPP.c ****     memcpy(current_data, calibrated_current_array, sizeof(calibrated_current_array));
 243:UserAPP/Source/ADCAPP.c **** 
 244:UserAPP/Source/ADCAPP.c ****     /* 使用 BuildReplyPacket 构建数据包 */
 245:UserAPP/Source/ADCAPP.c ****     uint8_t outBuf[PACKET_MAX_SIZE]; // 输出缓冲区
 246:UserAPP/Source/ADCAPP.c ****     uint16_t outLen = 0; // 输出长度
 247:UserAPP/Source/ADCAPP.c **** 
 248:UserAPP/Source/ADCAPP.c ****     uint8_t buildRet = BuildReplyPacket((uint8_t)FUNCTION_CODE_DataPacket,
 249:UserAPP/Source/ADCAPP.c ****                                         TASK_ID_SendCurrentPacket,
 250:UserAPP/Source/ADCAPP.c ****                                         current_data,
 251:UserAPP/Source/ADCAPP.c ****                                         (uint8_t)sizeof(current_data),
 252:UserAPP/Source/ADCAPP.c ****                                         outBuf,
 253:UserAPP/Source/ADCAPP.c ****                                         &outLen); // 构建电流数据包
 254:UserAPP/Source/ADCAPP.c **** 
