 135:UserAPP/Source/ADCAPP.c **** /**
 136:UserAPP/Source/ADCAPP.c ****  * @brief 将ADC采样值转换为实际输入电压
 137:UserAPP/Source/ADCAPP.c ****  * @param adc_value: ADC采集到的数字值（0~4095）
 138:UserAPP/Source/ADCAPP.c ****  * @return 实际输入电压值，单位V（范围约-20.12~+20.12V）
 139:UserAPP/Source/ADCAPP.c ****  */
 140:UserAPP/Source/ADCAPP.c **** float adc_to_voltage(uint16_t adc_value) // 转换函数实现
 141:UserAPP/Source/ADCAPP.c **** {
 142:UserAPP/Source/ADCAPP.c ****     float adc_voltage = (float)adc_value * ADC_REF_VOLTAGE / ADC_RESOLUTION; // 计算引脚电压
 143:UserAPP/Source/ADCAPP.c ****     
 144:UserAPP/Source/ADCAPP.c ****     // 原始公式：V_in = (V_pin * LEVEL_SHIFT - V_ref) / DIV_RATIO
 145:UserAPP/Source/ADCAPP.c ****     float raw_voltage = ((adc_voltage * LEVEL_SHIFT_RATIO) - ADC_REF_VOLTAGE) / VOLTAGE_DIV_RATIO;
 146:UserAPP/Source/ADCAPP.c ****     
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccrt06u6.s 			page 4


 147:UserAPP/Source/ADCAPP.c ****     // 不使用固定静态偏移，直接返回物理换算值。
 148:UserAPP/Source/ADCAPP.c ****     return raw_voltage;
 149:UserAPP/Source/ADCAPP.c **** }
 150:UserAPP/Source/ADCAPP.c **** 
