 166:UserAPP/Source/ADCAPP.c **** /**
 167:UserAPP/Source/ADCAPP.c ****  * @brief 发送电压数据包给上位机
 168:UserAPP/Source/ADCAPP.c ****  * @note 将11个ADC通道的电压值转换后通过BuildReplyPacket构建数据包发送
 169:UserAPP/Source/ADCAPP.c ****  */
 170:UserAPP/Source/ADCAPP.c **** void send_voltage_packet(void) // 发送电压数据包的实现
 171:UserAPP/Source/ADCAPP.c **** {
 172:UserAPP/Source/ADCAPP.c ****     // 校准每个通道的电压（更新全局校准数组
 173:UserAPP/Source/ADCAPP.c ****     calibrate_channel_voltage(); 
 174:UserAPP/Source/ADCAPP.c **** 
 175:UserAPP/Source/ADCAPP.c ****     // 每轮都基于最新ADC值更新“原始/校准后”电压，避免发送陈旧校准数�
 176:UserAPP/Source/ADCAPP.c ****     for (uint8_t i = 0; i < ADC_CHANNEL_COUNT; i++)
 177:UserAPP/Source/ADCAPP.c ****     {
 178:UserAPP/Source/ADCAPP.c ****         float raw_voltage = adc_to_voltage((uint16_t)adcbuf[i]);
 179:UserAPP/Source/ADCAPP.c ****         voltage_array[i] = raw_voltage;
 180:UserAPP/Source/ADCAPP.c ****         calibrated_voltage_array[i] = raw_voltage - channel_voltage_offset[i];
 181:UserAPP/Source/ADCAPP.c ****     }
 182:UserAPP/Source/ADCAPP.c **** 
 183:UserAPP/Source/ADCAPP.c ****     /* 直接将浮点电压数组按内存布局打包为字节流（小端float，44字节） */
 184:UserAPP/Source/ADCAPP.c ****     uint8_t voltage_data[sizeof(calibrated_voltage_array)];
 185:UserAPP/Source/ADCAPP.c ****     memcpy(voltage_data, calibrated_voltage_array, sizeof(calibrated_voltage_array));
 186:UserAPP/Source/ADCAPP.c **** 
 187:UserAPP/Source/ADCAPP.c ****     /* 使用 BuildReplyPacket 构建数据包 */
 188:UserAPP/Source/ADCAPP.c ****     uint8_t outBuf[PACKET_MAX_SIZE]; // 输出缓冲区
 189:UserAPP/Source/ADCAPP.c ****     uint16_t outLen = 0; // 输出长度
 190:UserAPP/Source/ADCAPP.c ****     
 191:UserAPP/Source/ADCAPP.c ****     // 功能码使用 FUNCTION_CODE_DataPacket(0x02)，execIndex可自定义（这里用0表示电
 192:UserAPP/Source/ADCAPP.c ****     uint8_t buildRet = BuildReplyPacket((uint8_t)FUNCTION_CODE_DataPacket, TASK_ID_SendVoltagePacke
 193:UserAPP/Source/ADCAPP.c ****     
 194:UserAPP/Source/ADCAPP.c ****     if (buildRet != 0) // 检查构建结果
 195:UserAPP/Source/ADCAPP.c ****     {
 196:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) { // 若队列存在则记录错误
 197:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "构建电压数据包失败，错误码=%u\r\n", build
 198:UserAPP/Source/ADCAPP.c ****         }
 199:UserAPP/Source/ADCAPP.c ****         return; // 构建失败，返回
 200:UserAPP/Source/ADCAPP.c ****     }
 201:UserAPP/Source/ADCAPP.c **** 
 202:UserAPP/Source/ADCAPP.c ****     /* 通过统一发送队列串行化发送，避免与应答/日志并发冲突 */
 203:UserAPP/Source/ADCAPP.c ****     if (SendBinaryToHost(outBuf, outLen, pdMS_TO_TICKS(20)) == pdPASS)
 204:UserAPP/Source/ADCAPP.c ****     {
 205:UserAPP/Source/ADCAPP.c ****         #if TEST_MODE
 206:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 207:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "电压数据包入队成功，长度=%u\r\n", outLen);
 208:UserAPP/Source/ADCAPP.c ****         }
 209:UserAPP/Source/ADCAPP.c ****         #endif
 210:UserAPP/Source/ADCAPP.c ****     }
 211:UserAPP/Source/ADCAPP.c ****     else
 212:UserAPP/Source/ADCAPP.c ****     {
 213:UserAPP/Source/ADCAPP.c ****         // 队列满/阻塞时直接串口兜底发送，保证上位机可收到电压包。
 214:UserAPP/Source/ADCAPP.c ****         UART1_SendBlocking(outBuf, outLen);
 215:UserAPP/Source/ADCAPP.c ****     }
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccr2mfvz.s 			page 12


 216:UserAPP/Source/ADCAPP.c **** }
 217:UserAPP/Source/ADCAPP.c **** 
