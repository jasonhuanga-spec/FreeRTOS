 218:UserAPP/Source/ADCAPP.c **** /**
 219:UserAPP/Source/ADCAPP.c ****  * @brief 发送电流数据包给上位机
 220:UserAPP/Source/ADCAPP.c ****  * @note 将11个ADC通道电流做滑动平均后通过BuildReplyPacket构建数据包发送
 221:UserAPP/Source/ADCAPP.c ****  */
 222:UserAPP/Source/ADCAPP.c **** void send_current_packet(void)
 223:UserAPP/Source/ADCAPP.c **** {
