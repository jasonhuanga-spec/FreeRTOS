 169:UserAPP/Source/ADCAPP.c **** /**
 170:UserAPP/Source/ADCAPP.c ****  * @brief 发送电压数据包给上位机
 171:UserAPP/Source/ADCAPP.c ****  * @note 将11个ADC通道的电压值转换后通过BuildReplyPacket构建数据包发送
 172:UserAPP/Source/ADCAPP.c ****  */
 173:UserAPP/Source/ADCAPP.c **** void send_voltage_packet(void) // 发送电压数据包的实现
 174:UserAPP/Source/ADCAPP.c **** {
 175:UserAPP/Source/ADCAPP.c ****     // 校准每个通道的电压（更新全局校准数组
 176:UserAPP/Source/ADCAPP.c ****     calibrate_channel_voltage(); 
 177:UserAPP/Source/ADCAPP.c **** 
 178:UserAPP/Source/ADCAPP.c ****     // 每轮都基于最新ADC值更新“原始/校准后”电压，避免发送陈旧校准数�
 179:UserAPP/Source/ADCAPP.c ****     for (uint8_t i = 0; i < ADC_CHANNEL_COUNT; i++)
 180:UserAPP/Source/ADCAPP.c ****     {
 181:UserAPP/Source/ADCAPP.c ****         float raw_voltage = adc_to_voltage((uint16_t)adcbuf[i]);
 182:UserAPP/Source/ADCAPP.c ****         voltage_array[i] = raw_voltage;
 183:UserAPP/Source/ADCAPP.c ****         calibrated_voltage_array[i] = raw_voltage - channel_voltage_offset[i];
 184:UserAPP/Source/ADCAPP.c ****     }
 185:UserAPP/Source/ADCAPP.c **** 
 186:UserAPP/Source/ADCAPP.c ****     /* 直接将浮点电压数组按内存布局打包为字节流（小端float，44字节） */
 187:UserAPP/Source/ADCAPP.c ****     uint8_t voltage_data[sizeof(calibrated_voltage_array)];
 188:UserAPP/Source/ADCAPP.c ****     memcpy(voltage_data, calibrated_voltage_array, sizeof(calibrated_voltage_array));
 189:UserAPP/Source/ADCAPP.c **** 
 190:UserAPP/Source/ADCAPP.c ****     /* 使用 BuildReplyPacket 构建数据包 */
 191:UserAPP/Source/ADCAPP.c ****     uint8_t outBuf[PACKET_MAX_SIZE]; // 输出缓冲区
 192:UserAPP/Source/ADCAPP.c ****     uint16_t outLen = 0; // 输出长度
 193:UserAPP/Source/ADCAPP.c ****     
 194:UserAPP/Source/ADCAPP.c ****     // 功能码使用 FUNCTION_CODE_DataPacket(0x02)，execIndex可自定义（这里用0表示电
 195:UserAPP/Source/ADCAPP.c ****     uint8_t buildRet = BuildReplyPacket((uint8_t)FUNCTION_CODE_DataPacket, TASK_ID_SendVoltagePacke
 196:UserAPP/Source/ADCAPP.c ****     
 197:UserAPP/Source/ADCAPP.c ****     if (buildRet != 0) // 检查构建结果
 198:UserAPP/Source/ADCAPP.c ****     {
 199:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) { // 若队列存在则记录错误
 200:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "构建电压数据包失败，错误码=%u\r\n", build
 201:UserAPP/Source/ADCAPP.c ****         }
 202:UserAPP/Source/ADCAPP.c ****         return; // 构建失败，返回
 203:UserAPP/Source/ADCAPP.c ****     }
 204:UserAPP/Source/ADCAPP.c **** 
 205:UserAPP/Source/ADCAPP.c ****     /* 通过统一发送队列串行化发送，避免与应答/日志并发冲突 */
 206:UserAPP/Source/ADCAPP.c ****     if (SendBinaryToHost(outBuf, outLen, pdMS_TO_TICKS(20)) == pdPASS)
 207:UserAPP/Source/ADCAPP.c ****     {
 208:UserAPP/Source/ADCAPP.c ****         #if TEST_MODE
 209:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 210:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "电压数据包入队成功，长度=%u\r\n", outLen);
 211:UserAPP/Source/ADCAPP.c ****         }
 212:UserAPP/Source/ADCAPP.c ****         #endif
 213:UserAPP/Source/ADCAPP.c ****     }
 214:UserAPP/Source/ADCAPP.c ****     else
 215:UserAPP/Source/ADCAPP.c ****     {
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccrt06u6.s 			page 12


 216:UserAPP/Source/ADCAPP.c ****         // 队列满/阻塞时直接串口兜底发送，保证上位机可收到电压包。
 217:UserAPP/Source/ADCAPP.c ****         UART1_SendBlocking(outBuf, outLen);
 218:UserAPP/Source/ADCAPP.c ****     }
 219:UserAPP/Source/ADCAPP.c **** }
 220:UserAPP/Source/ADCAPP.c **** 
 221:UserAPP/Source/ADCAPP.c **** 
 222:UserAPP/Source/ADCAPP.c **** /**
 223:UserAPP/Source/ADCAPP.c ****  * @brief 发送电流数据包给上位机
 224:UserAPP/Source/ADCAPP.c ****  * @note 将11个ADC通道电流做滑动平均后通过BuildReplyPacket构建数据包发送
 225:UserAPP/Source/ADCAPP.c ****  */
 226:UserAPP/Source/ADCAPP.c **** void send_current_packet(void)
 227:UserAPP/Source/ADCAPP.c **** {
 228:UserAPP/Source/ADCAPP.c ****     // 校准每个通道的电流（更新全局校准数组）
 229:UserAPP/Source/ADCAPP.c ****     calibrate_channel_current(); 
 230:UserAPP/Source/ADCAPP.c ****     // 每轮都基于最新ADC值更新“原始/校准后”电流，避免发送陈旧校准数�
 231:UserAPP/Source/ADCAPP.c ****     for (uint8_t i = 0; i < ADC_CHANNEL_COUNT; i++)
 232:UserAPP/Source/ADCAPP.c ****     {
 233:UserAPP/Source/ADCAPP.c ****         // 1) 用“校准后电压”换算瞬时电流，保证电压/电流口径一致。
 234:UserAPP/Source/ADCAPP.c ****         float raw_current = channel_voltage_to_current_diff(calibrated_voltage_array[i]);
 235:UserAPP/Source/ADCAPP.c ****         current_array[i] = raw_current;
 236:UserAPP/Source/ADCAPP.c ****         if (current_offset_ready) {
 237:UserAPP/Source/ADCAPP.c ****             calibrated_current_array[i] = current_array[i] - channel_current_offset[i];
 238:UserAPP/Source/ADCAPP.c ****         } else {
 239:UserAPP/Source/ADCAPP.c ****             calibrated_current_array[i] = current_array[i];
 240:UserAPP/Source/ADCAPP.c ****         }
 241:UserAPP/Source/ADCAPP.c ****     }
 242:UserAPP/Source/ADCAPP.c **** 
 243:UserAPP/Source/ADCAPP.c **** 
 244:UserAPP/Source/ADCAPP.c ****     /* 将校准后电流数组按内存布局打包为字节流（小端float，44字节） */
 245:UserAPP/Source/ADCAPP.c ****     uint8_t current_data[sizeof(calibrated_current_array)];
 246:UserAPP/Source/ADCAPP.c ****     memcpy(current_data, calibrated_current_array, sizeof(calibrated_current_array));
 247:UserAPP/Source/ADCAPP.c **** 
 248:UserAPP/Source/ADCAPP.c ****     /* 使用 BuildReplyPacket 构建数据包 */
 249:UserAPP/Source/ADCAPP.c ****     uint8_t outBuf[PACKET_MAX_SIZE]; // 输出缓冲区
 250:UserAPP/Source/ADCAPP.c ****     uint16_t outLen = 0; // 输出长度
 251:UserAPP/Source/ADCAPP.c **** 
 252:UserAPP/Source/ADCAPP.c ****     uint8_t buildRet = BuildReplyPacket((uint8_t)FUNCTION_CODE_DataPacket,
 253:UserAPP/Source/ADCAPP.c ****                                         TASK_ID_SendCurrentPacket,
 254:UserAPP/Source/ADCAPP.c ****                                         current_data,
 255:UserAPP/Source/ADCAPP.c ****                                         (uint8_t)sizeof(current_data),
 256:UserAPP/Source/ADCAPP.c ****                                         outBuf,
 257:UserAPP/Source/ADCAPP.c ****                                         &outLen); // 构建电流数据包
 258:UserAPP/Source/ADCAPP.c **** 
 259:UserAPP/Source/ADCAPP.c ****     if (buildRet != 0) // 检查构建结果
 260:UserAPP/Source/ADCAPP.c ****     {
 261:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 262:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "构建电流数据包失败，错误码=%u\r\n", build
 263:UserAPP/Source/ADCAPP.c ****         }
 264:UserAPP/Source/ADCAPP.c ****         return;
 265:UserAPP/Source/ADCAPP.c ****     }
 266:UserAPP/Source/ADCAPP.c **** 
 267:UserAPP/Source/ADCAPP.c ****     /* 通过统一发送队列串行化发送，避免与应答/日志并发冲突 */
 268:UserAPP/Source/ADCAPP.c ****     if (SendBinaryToHost(outBuf, outLen, pdMS_TO_TICKS(20)) == pdPASS)
 269:UserAPP/Source/ADCAPP.c ****     {
 270:UserAPP/Source/ADCAPP.c ****         #if TEST_MODE
 271:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 272:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "电流数据包入队成功，长度=%u\r\n", outLen);
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccrt06u6.s 			page 13


 273:UserAPP/Source/ADCAPP.c ****         }
 274:UserAPP/Source/ADCAPP.c ****         #endif
 275:UserAPP/Source/ADCAPP.c ****     }
 276:UserAPP/Source/ADCAPP.c ****     else
 277:UserAPP/Source/ADCAPP.c ****     {
 278:UserAPP/Source/ADCAPP.c ****         UART1_SendBlocking(outBuf, outLen);
 279:UserAPP/Source/ADCAPP.c ****     }
 280:UserAPP/Source/ADCAPP.c **** }
