 225:UserAPP/Source/ADCAPP.c ****     calibrate_channel_current(); 
 226:UserAPP/Source/ADCAPP.c ****     // 每轮都基于最新ADC值更新“原始/校准后”电流，避免发送陈旧校准数�
 227:UserAPP/Source/ADCAPP.c ****     for (uint8_t i = 0; i < ADC_CHANNEL_COUNT; i++)
 228:UserAPP/Source/ADCAPP.c ****     {
 229:UserAPP/Source/ADCAPP.c ****         // 1) 用“校准后电压”换算瞬时电流，保证电压/电流口径一致。
 230:UserAPP/Source/ADCAPP.c ****         float raw_current = channel_voltage_to_current_diff(calibrated_voltage_array[i]);
 231:UserAPP/Source/ADCAPP.c ****         current_array[i] = raw_current;
 232:UserAPP/Source/ADCAPP.c ****         if (current_offset_ready) {
 233:UserAPP/Source/ADCAPP.c ****             calibrated_current_array[i] = current_array[i] - channel_current_offset[i];
 234:UserAPP/Source/ADCAPP.c ****         } else {
 235:UserAPP/Source/ADCAPP.c ****             calibrated_current_array[i] = current_array[i];
 236:UserAPP/Source/ADCAPP.c ****         }
