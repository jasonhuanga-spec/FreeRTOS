 115:UserAPP/Source/ADCAPP.c **** /**
 116:UserAPP/Source/ADCAPP.c ****  * @brief 将ADC采样值转换为实际输入电压
 117:UserAPP/Source/ADCAPP.c ****  * @param adc_value: ADC采集到的数字值（0~4095）
 118:UserAPP/Source/ADCAPP.c ****  * @return 实际输入电压值，单位V（范围约-20.12~+20.12V）
 119:UserAPP/Source/ADCAPP.c ****  */
 120:UserAPP/Source/ADCAPP.c **** float adc_to_voltage(uint16_t adc_value) // 转换函数实现
 121:UserAPP/Source/ADCAPP.c **** {
 122:UserAPP/Source/ADCAPP.c ****     float adc_voltage = (float)adc_value * ADC_REF_VOLTAGE / ADC_RESOLUTION; // 计算引脚电压
 123:UserAPP/Source/ADCAPP.c ****     
 124:UserAPP/Source/ADCAPP.c ****     // 原始公式：V_in = (V_pin * LEVEL_SHIFT - V_ref) / DIV_RATIO
 125:UserAPP/Source/ADCAPP.c ****     float raw_voltage = ((adc_voltage * LEVEL_SHIFT_RATIO) - ADC_REF_VOLTAGE) / VOLTAGE_DIV_RATIO;
 126:UserAPP/Source/ADCAPP.c ****     
 127:UserAPP/Source/ADCAPP.c ****     // 应用线性补偿
 128:UserAPP/Source/ADCAPP.c ****     return raw_voltage + ADC_VOLTAGE_OFFSET; 
 129:UserAPP/Source/ADCAPP.c **** }
 130:UserAPP/Source/ADCAPP.c **** 
 131:UserAPP/Source/ADCAPP.c **** /**
 132:UserAPP/Source/ADCAPP.c ****  * @brief 电压差分法：由通道电压快速换算电流
 133:UserAPP/Source/ADCAPP.c ****  * @param channel_voltage 通道电压（单位V）
 134:UserAPP/Source/ADCAPP.c ****  * @return float 电流值（单位mA）
 135:UserAPP/Source/ADCAPP.c ****  */
 136:UserAPP/Source/ADCAPP.c **** static float channel_voltage_to_current_diff(float channel_voltage)
 137:UserAPP/Source/ADCAPP.c **** {
