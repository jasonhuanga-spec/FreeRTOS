  95:UserAPP/Source/ADCAPP.c **** /**
  96:UserAPP/Source/ADCAPP.c ****  * @brief 启动ADC DMA转换并等待完成
  97:UserAPP/Source/ADCAPP.c ****  * @return uint8_t 返回转换状态：0表示成功，非0表示失败
  98:UserAPP/Source/ADCAPP.c ****  */
  99:UserAPP/Source/ADCAPP.c **** uint8_t vADC_StartConversion(void) // ADC DMA转换函数
 100:UserAPP/Source/ADCAPP.c **** {
 101:UserAPP/Source/ADCAPP.c ****     adc_dma_complete = 0; // 清除完成标志
 102:UserAPP/Source/ADCAPP.c ****     
 103:UserAPP/Source/ADCAPP.c ****     /* 启动 DMA 转换，采样 11 个通道到 adcbuf */
 104:UserAPP/Source/ADCAPP.c ****     if (HAL_ADC_Start_DMA(&hadc1, adcbuf, 11) != HAL_OK) // 启动 DMA
 105:UserAPP/Source/ADCAPP.c ****     {
 106:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) { // 检查发送队列有效性
 107:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "ADC Start DMA Error\r\n"); // 发送错误信息
 108:UserAPP/Source/ADCAPP.c ****         }
 109:UserAPP/Source/ADCAPP.c ****         return 1; // 返回错误
 110:UserAPP/Source/ADCAPP.c ****     }
 111:UserAPP/Source/ADCAPP.c **** 
 112:UserAPP/Source/ADCAPP.c ****     /* 等待转换完成，增加超时机制（10ms足够11个通道转换） */
 113:UserAPP/Source/ADCAPP.c ****     uint32_t timeout = 10; // 超时计数 10ms
 114:UserAPP/Source/ADCAPP.c ****     while (adc_dma_complete == 0 && timeout > 0) // 等待完成标志或超时
 115:UserAPP/Source/ADCAPP.c ****     {
 116:UserAPP/Source/ADCAPP.c ****         vTaskDelay(pdMS_TO_TICKS(1)); // 挂起 1ms 避免独占 CPU
 117:UserAPP/Source/ADCAPP.c ****         timeout--; // 递减计数
 118:UserAPP/Source/ADCAPP.c ****     }
 119:UserAPP/Source/ADCAPP.c ****     
 120:UserAPP/Source/ADCAPP.c ****     HAL_ADC_Stop_DMA(&hadc1); // 停止 ADC DMA
 121:UserAPP/Source/ADCAPP.c **** 
 122:UserAPP/Source/ADCAPP.c ****     if (timeout == 0) // 检查是否超时
 123:UserAPP/Source/ADCAPP.c ****     {
 124:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) { // 检查发送队列有效性
 125:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "ADC DMA Timeout\r\n"); // 发送超时信息
 126:UserAPP/Source/ADCAPP.c ****         }
 127:UserAPP/Source/ADCAPP.c ****         return 2; // 返回超时错误
 128:UserAPP/Source/ADCAPP.c ****     }
 129:UserAPP/Source/ADCAPP.c ****     
 130:UserAPP/Source/ADCAPP.c ****     return 0; // 返回成功
 131:UserAPP/Source/ADCAPP.c **** }
 132:UserAPP/Source/ADCAPP.c **** 
 133:UserAPP/Source/ADCAPP.c **** 
