  20:UserAPP/Source/ADCAPP.c **** float calibrated_voltage_array[11] = {0.0f};
  21:UserAPP/Source/ADCAPP.c **** // 每通道校准偏置（默认0，可按通道写入实际标定值）
  22:UserAPP/Source/ADCAPP.c **** static float channel_voltage_offset[ADC_CHANNEL_COUNT] = {0.0f};
  23:UserAPP/Source/ADCAPP.c **** 
