 219:UserAPP/Source/ADCAPP.c **** /**
 220:UserAPP/Source/ADCAPP.c ****  * @brief 发送电流数据包给上位机
 221:UserAPP/Source/ADCAPP.c ****  * @note 将11个ADC通道电流做滑动平均后通过BuildReplyPacket构建数据包发送
 222:UserAPP/Source/ADCAPP.c ****  */
 223:UserAPP/Source/ADCAPP.c **** void send_current_packet(void)
 224:UserAPP/Source/ADCAPP.c **** {
 225:UserAPP/Source/ADCAPP.c ****     // 校准每个通道的电流（更新全局校准数组）
 226:UserAPP/Source/ADCAPP.c ****     calibrate_channel_current(); 
 227:UserAPP/Source/ADCAPP.c ****     // 每轮都基于最新ADC值更新“原始/校准后”电流，避免发送陈旧校准数�
 228:UserAPP/Source/ADCAPP.c ****     for (uint8_t i = 0; i < ADC_CHANNEL_COUNT; i++)
 229:UserAPP/Source/ADCAPP.c ****     {
 230:UserAPP/Source/ADCAPP.c ****         // 1) 用“校准后电压”换算瞬时电流，保证电压/电流口径一致。
 231:UserAPP/Source/ADCAPP.c ****         float raw_current = channel_voltage_to_current_diff(calibrated_voltage_array[i]);
 232:UserAPP/Source/ADCAPP.c ****         current_array[i] = raw_current;
 233:UserAPP/Source/ADCAPP.c ****         if (current_offset_ready) {
 234:UserAPP/Source/ADCAPP.c ****             calibrated_current_array[i] = current_array[i] - channel_current_offset[i];
 235:UserAPP/Source/ADCAPP.c ****         } else {
 236:UserAPP/Source/ADCAPP.c ****             calibrated_current_array[i] = current_array[i];
 237:UserAPP/Source/ADCAPP.c ****         }
 238:UserAPP/Source/ADCAPP.c ****     }
 239:UserAPP/Source/ADCAPP.c **** 
 240:UserAPP/Source/ADCAPP.c **** 
 241:UserAPP/Source/ADCAPP.c ****     /* 将校准后电流数组按内存布局打包为字节流（小端float，44字节） */
 242:UserAPP/Source/ADCAPP.c ****     uint8_t current_data[sizeof(calibrated_current_array)];
 243:UserAPP/Source/ADCAPP.c ****     memcpy(current_data, calibrated_current_array, sizeof(calibrated_current_array));
 244:UserAPP/Source/ADCAPP.c **** 
 245:UserAPP/Source/ADCAPP.c ****     /* 使用 BuildReplyPacket 构建数据包 */
 246:UserAPP/Source/ADCAPP.c ****     uint8_t outBuf[PACKET_MAX_SIZE]; // 输出缓冲区
 247:UserAPP/Source/ADCAPP.c ****     uint16_t outLen = 0; // 输出长度
 248:UserAPP/Source/ADCAPP.c **** 
 249:UserAPP/Source/ADCAPP.c ****     uint8_t buildRet = BuildReplyPacket((uint8_t)FUNCTION_CODE_DataPacket,
 250:UserAPP/Source/ADCAPP.c ****                                         TASK_ID_SendCurrentPacket,
 251:UserAPP/Source/ADCAPP.c ****                                         current_data,
 252:UserAPP/Source/ADCAPP.c ****                                         (uint8_t)sizeof(current_data),
 253:UserAPP/Source/ADCAPP.c ****                                         outBuf,
 254:UserAPP/Source/ADCAPP.c ****                                         &outLen); // 构建电流数据包
 255:UserAPP/Source/ADCAPP.c **** 
 256:UserAPP/Source/ADCAPP.c ****     if (buildRet != 0) // 检查构建结果
 257:UserAPP/Source/ADCAPP.c ****     {
 258:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 259:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "构建电流数据包失败，错误码=%u\r\n", build
 260:UserAPP/Source/ADCAPP.c ****         }
 261:UserAPP/Source/ADCAPP.c ****         return;
 262:UserAPP/Source/ADCAPP.c ****     }
 263:UserAPP/Source/ADCAPP.c **** 
 264:UserAPP/Source/ADCAPP.c ****     /* 通过统一发送队列串行化发送，避免与应答/日志并发冲突 */
 265:UserAPP/Source/ADCAPP.c ****     if (SendBinaryToHost(outBuf, outLen, pdMS_TO_TICKS(20)) == pdPASS)
 266:UserAPP/Source/ADCAPP.c ****     {
 267:UserAPP/Source/ADCAPP.c ****         #if TEST_MODE
 268:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 269:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "电流数据包入队成功，长度=%u\r\n", outLen);
 270:UserAPP/Source/ADCAPP.c ****         }
 271:UserAPP/Source/ADCAPP.c ****         #endif
 272:UserAPP/Source/ADCAPP.c ****     }
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccr2mfvz.s 			page 13


 273:UserAPP/Source/ADCAPP.c ****     else
 274:UserAPP/Source/ADCAPP.c ****     {
 275:UserAPP/Source/ADCAPP.c ****         UART1_SendBlocking(outBuf, outLen);
 276:UserAPP/Source/ADCAPP.c ****     }
 277:UserAPP/Source/ADCAPP.c **** }
