  46:UserAPP/Source/ADCAPP.c ****  */
  47:UserAPP/Source/ADCAPP.c **** void vADCProcessTask(void *pvParameters) // ADC 任务实现
  48:UserAPP/Source/ADCAPP.c **** {
  49:UserAPP/Source/ADCAPP.c ****     /* 避免编译器警告未使用参数 */ // 每行注释
  50:UserAPP/Source/ADCAPP.c ****     (void)pvParameters;
  51:UserAPP/Source/ADCAPP.c **** 
  52:UserAPP/Source/ADCAPP.c ****     for (;;) // 任务主循环
  53:UserAPP/Source/ADCAPP.c ****     {
  54:UserAPP/Source/ADCAPP.c ****         vADC_StartConversion();    // 启动ADC DMA采样并等待完成
  55:UserAPP/Source/ADCAPP.c ****         SetESLVDDVoltage();        // PID单步调节VDD电压（利用刚采样的数据）
  56:UserAPP/Source/ADCAPP.c ****         send_voltage_packet();     // 将电压数据打包发送给上位机
