  60:UserAPP/Source/ADCAPP.c **** /**
  61:UserAPP/Source/ADCAPP.c ****  * @brief ADC 处理任务主循环
  62:UserAPP/Source/ADCAPP.c ****  * @param pvParameters 任务参数（未使用）
  63:UserAPP/Source/ADCAPP.c ****  */
  64:UserAPP/Source/ADCAPP.c **** void vADCProcessTask(void *pvParameters) // ADC 任务实现
  65:UserAPP/Source/ADCAPP.c **** {
  66:UserAPP/Source/ADCAPP.c ****     /* 避免编译器警告未使用参数 */ // 每行注释
  67:UserAPP/Source/ADCAPP.c ****     (void)pvParameters;
  68:UserAPP/Source/ADCAPP.c **** 
  69:UserAPP/Source/ADCAPP.c ****     for (;;) // 任务主循环
  70:UserAPP/Source/ADCAPP.c ****     {
  71:UserAPP/Source/ADCAPP.c ****         vADC_StartConversion();    // 启动ADC DMA采样并等待完成
  72:UserAPP/Source/ADCAPP.c ****         SetESLVDDVoltage();        // PID单步调节VDD电压（利用刚采样的数据）
  73:UserAPP/Source/ADCAPP.c ****         send_voltage_packet();     // 将电压数据打包发送给上位机
  74:UserAPP/Source/ADCAPP.c ****         send_current_packet();     // 将电流数据打包发送给上位机
  75:UserAPP/Source/ADCAPP.c **** 
  76:UserAPP/Source/ADCAPP.c ****         vTaskDelay(pdMS_TO_TICKS(10)); // 延迟10ms等待电压稳定（PID控制周期）
  77:UserAPP/Source/ADCAPP.c ****     }
  78:UserAPP/Source/ADCAPP.c **** }
  79:UserAPP/Source/ADCAPP.c **** 
