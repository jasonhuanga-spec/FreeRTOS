 256:UserAPP/Source/ADCAPP.c ****     {
 257:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 258:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "构建电流数据包失败，错误码=%u\r\n", build
 259:UserAPP/Source/ADCAPP.c ****         }
 260:UserAPP/Source/ADCAPP.c ****         return;
 261:UserAPP/Source/ADCAPP.c ****     }
 262:UserAPP/Source/ADCAPP.c **** 
 263:UserAPP/Source/ADCAPP.c ****     /* 通过统一发送队列串行化发送，避免与应答/日志并发冲突 */
 264:UserAPP/Source/ADCAPP.c ****     if (SendBinaryToHost(outBuf, outLen, pdMS_TO_TICKS(20)) == pdPASS)
 265:UserAPP/Source/ADCAPP.c ****     {
 266:UserAPP/Source/ADCAPP.c ****         #if TEST_MODE
 267:UserAPP/Source/ADCAPP.c ****         if (xSendDataQueue != NULL) {
 268:UserAPP/Source/ADCAPP.c ****             QueueSendfmt(xSendDataQueue, 0, "电流数据包入队成功，长度=%u\r\n", outLen);
 269:UserAPP/Source/ADCAPP.c ****         }
 270:UserAPP/Source/ADCAPP.c ****         #endif
 271:UserAPP/Source/ADCAPP.c ****     }
 272:UserAPP/Source/ADCAPP.c ****     else
