  93:UserAPP/Source/DPPTM.c **** /**
  94:UserAPP/Source/DPPTM.c ****  * @brief  查表 + PID微调 调节ESL VDD电压
  95:UserAPP/Source/DPPTM.c ****  * @说明   第一步：目标切换时查表直接命中精确码值（一步到位）
  96:UserAPP/Source/DPPTM.c ****  *         第二步：PID监控ADC反馈，在基准码值附近小范围微调补偿
  97:UserAPP/Source/DPPTM.c ****  *         每次被vADCProcessTask调用执行一步
  98:UserAPP/Source/DPPTM.c ****  */
  99:UserAPP/Source/DPPTM.c **** void SetESLVDDVoltage(void)
 100:UserAPP/Source/DPPTM.c **** {
 101:UserAPP/Source/DPPTM.c ****     /* -------- 0. 前置检查 -------- */
 102:UserAPP/Source/DPPTM.c ****     if (TargetVDDVoltage < 0.0f)                                                // 目标无效
 103:UserAPP/Source/DPPTM.c ****         return;
 104:UserAPP/Source/DPPTM.c **** 
 105:UserAPP/Source/DPPTM.c ****     float currentV = get_current_vdd_voltage();                                 // 读取当前VDD�
 106:UserAPP/Source/DPPTM.c ****     if (currentV < 0.0f)                                                       // ADC数据无效
 107:UserAPP/Source/DPPTM.c ****         return;
 108:UserAPP/Source/DPPTM.c **** 
 109:UserAPP/Source/DPPTM.c ****     /* -------- 1. 目标切换  查表直接命中 -------- */
 110:UserAPP/Source/DPPTM.c ****     if (TargetVDDVoltage != pid_lastTarget)
 111:UserAPP/Source/DPPTM.c ****     {
 112:UserAPP/Source/DPPTM.c ****         pid_integral  = 0.0f;                                                  // 重置积分
 113:UserAPP/Source/DPPTM.c ****         pid_lastError = 0.0f;                                                  // 重置微分
 114:UserAPP/Source/DPPTM.c ****         pid_lastTarget = TargetVDDVoltage;                                     // 记录新目标
 115:UserAPP/Source/DPPTM.c ****         pid_locked = 0;                                                        // 解锁
 116:UserAPP/Source/DPPTM.c **** 
 117:UserAPP/Source/DPPTM.c ****         pid_baseCode = voltage_to_code(TargetVDDVoltage);                       // 查表获取精�
 118:UserAPP/Source/DPPTM.c ****         pid_dpptm = pid_baseCode;                                              // 设置当前码�
 119:UserAPP/Source/DPPTM.c ****         ControlDPPTM(pid_dpptm);                                               // 一步写入
 120:UserAPP/Source/DPPTM.c **** 
 121:UserAPP/Source/DPPTM.c ****         #if TEST_MODE
 122:UserAPP/Source/DPPTM.c ****         QueueSendfmt(xSendDataQueue, 0,
 123:UserAPP/Source/DPPTM.c ****                      "查表命中: %.1fV -> DPPTM=0x%02X(%u)\r\n",
 124:UserAPP/Source/DPPTM.c ****                      TargetVDDVoltage, pid_dpptm, pid_dpptm);
 125:UserAPP/Source/DPPTM.c ****         #endif
 126:UserAPP/Source/DPPTM.c **** 
 127:UserAPP/Source/DPPTM.c ****         return;                                                                 // 等下一轮ADC�
 128:UserAPP/Source/DPPTM.c ****     }
 129:UserAPP/Source/DPPTM.c **** 
 130:UserAPP/Source/DPPTM.c ****     /* -------- 2. 已锁定  监控漂移 -------- */
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccek1Jex.s 			page 7


 131:UserAPP/Source/DPPTM.c ****     if (pid_locked)
 132:UserAPP/Source/DPPTM.c ****     {
 133:UserAPP/Source/DPPTM.c ****         float drift = TargetVDDVoltage - currentV;
 134:UserAPP/Source/DPPTM.c ****         if (drift >= -PID_TOLERANCE && drift <= PID_TOLERANCE)
 135:UserAPP/Source/DPPTM.c ****             return;                                                            // 仍在容差内�
 136:UserAPP/Source/DPPTM.c **** 
 137:UserAPP/Source/DPPTM.c ****         pid_locked = 0;                                                        // 漂移超差，�
 138:UserAPP/Source/DPPTM.c ****         pid_lastError = drift;                                                 // 初始化微分�
 139:UserAPP/Source/DPPTM.c ****     }
 140:UserAPP/Source/DPPTM.c **** 
 141:UserAPP/Source/DPPTM.c ****     /* -------- 3. PID微调 -------- */
 142:UserAPP/Source/DPPTM.c ****     float error = TargetVDDVoltage - currentV;                                  // 计算误差
 143:UserAPP/Source/DPPTM.c **** 
 144:UserAPP/Source/DPPTM.c ****     // 在容差内  锁定
 145:UserAPP/Source/DPPTM.c ****     if (error >= -PID_TOLERANCE && error <= PID_TOLERANCE)
 146:UserAPP/Source/DPPTM.c ****     {
 147:UserAPP/Source/DPPTM.c ****         pid_locked = 1;
 148:UserAPP/Source/DPPTM.c **** 
 149:UserAPP/Source/DPPTM.c ****         #if TEST_MODE
 150:UserAPP/Source/DPPTM.c ****         QueueSendfmt(xSendDataQueue, 0,
 151:UserAPP/Source/DPPTM.c ****                      "PID锁定: %.2fV, DPPTM=0x%02X(%u)\r\n",
 152:UserAPP/Source/DPPTM.c ****                      currentV, pid_dpptm, pid_dpptm);
 153:UserAPP/Source/DPPTM.c ****         #endif
 154:UserAPP/Source/DPPTM.c ****         
 155:UserAPP/Source/DPPTM.c ****         return;
 156:UserAPP/Source/DPPTM.c ****     }
 157:UserAPP/Source/DPPTM.c **** 
 158:UserAPP/Source/DPPTM.c ****     // PID计算
 159:UserAPP/Source/DPPTM.c ****     pid_integral += error;
 160:UserAPP/Source/DPPTM.c ****     if (pid_integral > PID_INTEGRAL_MAX) pid_integral = PID_INTEGRAL_MAX;
 161:UserAPP/Source/DPPTM.c ****     if (pid_integral < -PID_INTEGRAL_MAX) pid_integral = -PID_INTEGRAL_MAX;
 162:UserAPP/Source/DPPTM.c **** 
 163:UserAPP/Source/DPPTM.c ****     float derivative = error - pid_lastError;
 164:UserAPP/Source/DPPTM.c ****     pid_lastError = error;
 165:UserAPP/Source/DPPTM.c **** 
 166:UserAPP/Source/DPPTM.c ****     // PID输出（error>0  需增大码值升压  输出为正）
 167:UserAPP/Source/DPPTM.c ****     float output = (PID_KP * error + PID_KI * pid_integral + PID_KD * derivative);
 168:UserAPP/Source/DPPTM.c **** 
 169:UserAPP/Source/DPPTM.c ****     // 转为整数步进（PID输出不足半步时不调整，避免抖动）
 170:UserAPP/Source/DPPTM.c ****     int16_t step = 0;
 171:UserAPP/Source/DPPTM.c ****     if (output > 0.5f)       step = (int16_t)(output + 0.5f);                   // 正方向超半�
 172:UserAPP/Source/DPPTM.c ****     else if (output < -0.5f) step = (int16_t)(output - 0.5f);                   // 负方向超半�
 173:UserAPP/Source/DPPTM.c ****     // output在[-0.5, 0.5]之间 → step=0，不调整（查表已精确命中，无需强制步�
 174:UserAPP/Source/DPPTM.c **** 
 175:UserAPP/Source/DPPTM.c ****     if (step == 0)                                                             // PID认为无需�
 176:UserAPP/Source/DPPTM.c ****         return;                                                                // 跳过本轮
 177:UserAPP/Source/DPPTM.c **** 
 178:UserAPP/Source/DPPTM.c ****     // 限制在基准码值PID_MAX_TRIM步以内（防止PID跑飞）
 179:UserAPP/Source/DPPTM.c ****     int16_t newCode = (int16_t)pid_dpptm + step;
 180:UserAPP/Source/DPPTM.c ****     int16_t lo = (int16_t)pid_baseCode - PID_MAX_TRIM;                          // 微调下限
 181:UserAPP/Source/DPPTM.c ****     int16_t hi = (int16_t)pid_baseCode + PID_MAX_TRIM;                          // 微调上限
 182:UserAPP/Source/DPPTM.c ****     if (newCode < lo) newCode = lo;
 183:UserAPP/Source/DPPTM.c ****     if (newCode > hi) newCode = hi;
 184:UserAPP/Source/DPPTM.c ****     if (newCode < DPPTM_CODE_MIN) newCode = DPPTM_CODE_MIN;                     // 绝对下限（0
 185:UserAPP/Source/DPPTM.c ****     if (newCode > DPPTM_CODE_MAX) newCode = DPPTM_CODE_MAX;                     // 绝对上限（0
 186:UserAPP/Source/DPPTM.c **** 
 187:UserAPP/Source/DPPTM.c ****     pid_dpptm = (uint8_t)newCode;
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccek1Jex.s 			page 8


 188:UserAPP/Source/DPPTM.c ****     ControlDPPTM(pid_dpptm);                                                   // 写入微调码�
 189:UserAPP/Source/DPPTM.c **** }
