   1:UserAPP/Source/DPPTM.c **** ﻿#include "DPPTM.h"
   2:UserAPP/Source/DPPTM.c **** 
   3:UserAPP/Source/DPPTM.c **** /* 目标VDD电压全局变量，由HWCI任务设置，PID任务读取 */
   4:UserAPP/Source/DPPTM.c **** float TargetVDDVoltage = 3.3f;
   5:UserAPP/Source/DPPTM.c **** 
   6:UserAPP/Source/DPPTM.c **** /*=================== 实测校准查表（0.0V~3.3V，0.1V步进） ===================*/
   7:UserAPP/Source/DPPTM.c **** /* 索引 = 目标电压 / 0.1，范围 0~33 对应 0.0V~3.3V
   8:UserAPP/Source/DPPTM.c ****  * 端点实测：0x00=0V，0x7F=3.3V
   9:UserAPP/Source/DPPTM.c ****  * 中间点先采用线性标定值，后续可按实测继续修正
  10:UserAPP/Source/DPPTM.c ****  */
  11:UserAPP/Source/DPPTM.c **** static const uint8_t voltage_code_table[34] = {
  12:UserAPP/Source/DPPTM.c ****     0x00, 0x04, 0x08, 0x0C, 0x0F, 0x13, 0x17, 0x1B,  // 0.0~0.7V
  13:UserAPP/Source/DPPTM.c ****     0x1F, 0x23, 0x26, 0x2A, 0x2E, 0x32, 0x36, 0x3A,  // 0.8~1.5V
  14:UserAPP/Source/DPPTM.c ****     0x3E, 0x41, 0x45, 0x49, 0x4D, 0x51, 0x55, 0x59,  // 1.6~2.3V
  15:UserAPP/Source/DPPTM.c ****     0x5C, 0x60, 0x64, 0x68, 0x6C, 0x70, 0x73, 0x77,  // 2.4~3.1V
  16:UserAPP/Source/DPPTM.c ****     0x7B, 0x7F                                                   // 3.2~3.3V
  17:UserAPP/Source/DPPTM.c **** };
  18:UserAPP/Source/DPPTM.c **** 
  19:UserAPP/Source/DPPTM.c **** #define VDD_MIN_VOLTAGE  0.0f                                                   // 最低目标电�
  20:UserAPP/Source/DPPTM.c **** #define VDD_MAX_VOLTAGE  3.3f                                                   // 最高目标电�
  21:UserAPP/Source/DPPTM.c **** #define VDD_STEP         0.1f                                                   // 电压步进
  22:UserAPP/Source/DPPTM.c **** #define VDD_TABLE_SIZE   34                                                     // 查表大小
  23:UserAPP/Source/DPPTM.c **** #define DPPTM_CODE_MIN   0x00                                                   // 数字电位器�
  24:UserAPP/Source/DPPTM.c **** #define DPPTM_CODE_MAX   0x7F                                                   // 数字电位器�
  25:UserAPP/Source/DPPTM.c **** 
