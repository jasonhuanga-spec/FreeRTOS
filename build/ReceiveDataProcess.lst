 111:UserAPP/Source/ReceiveDataProcess.c **** /** * @brief 在中断服务例程（ISR）中发送接收到的数据到接收队列
 112:UserAPP/Source/ReceiveDataProcess.c ****  *
 113:UserAPP/Source/ReceiveDataProcess.c ****  * @param Buf 指向接收到的数据缓冲区的指针
 114:UserAPP/Source/ReceiveDataProcess.c ****  * @param Len 指向数据长度的指针
 115:UserAPP/Source/ReceiveDataProcess.c ****  */
 116:UserAPP/Source/ReceiveDataProcess.c **** uint8_t vReceiveDataQueueSendISRTask(uint8_t* Buf, uint32_t *Len)
 117:UserAPP/Source/ReceiveDataProcess.c **** {
 118:UserAPP/Source/ReceiveDataProcess.c ****     if (*Len <= MAX_RECEIVE_DATA_SIZE && xReceiveDataQueue != NULL)
 119:UserAPP/Source/ReceiveDataProcess.c ****     {
 120:UserAPP/Source/ReceiveDataProcess.c ****         // 先清零接收缓冲区
 121:UserAPP/Source/ReceiveDataProcess.c ****         memset(&dataPacket, 0, sizeof(dataPacket));
 122:UserAPP/Source/ReceiveDataProcess.c **** 
 123:UserAPP/Source/ReceiveDataProcess.c ****         // 拷贝数据到数据包结构，确保数据持久化
 124:UserAPP/Source/ReceiveDataProcess.c ****         memcpy(dataPacket.data, Buf, *Len);
 125:UserAPP/Source/ReceiveDataProcess.c ****         dataPacket.length = *Len;
 126:UserAPP/Source/ReceiveDataProcess.c **** 
 127:UserAPP/Source/ReceiveDataProcess.c ****         // 将整个数据包结构发送到接收队列（不只是 data 数组，还包括 length
 128:UserAPP/Source/ReceiveDataProcess.c ****         if (xQueueSendFromISR(xReceiveDataQueue, &dataPacket, &xHigherPriorityTaskWoken) == errQUEU
 129:UserAPP/Source/ReceiveDataProcess.c ****             return (USBD_OK);
 130:UserAPP/Source/ReceiveDataProcess.c **** 
 131:UserAPP/Source/ReceiveDataProcess.c ****         portYIELD_FROM_ISR(xHigherPriorityTaskWoken);
 132:UserAPP/Source/ReceiveDataProcess.c ****     }
 133:UserAPP/Source/ReceiveDataProcess.c **** 
 134:UserAPP/Source/ReceiveDataProcess.c ****     return 0;
 135:UserAPP/Source/ReceiveDataProcess.c **** }
