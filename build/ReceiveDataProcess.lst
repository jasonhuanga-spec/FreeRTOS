 199:UserAPP/Source/ReceiveDataProcess.c **** static void vParseReceivedDataStream(const ReceiveDataPacket_t *packet)
 200:UserAPP/Source/ReceiveDataProcess.c **** {
 201:UserAPP/Source/ReceiveDataProcess.c ****     if (packet == NULL || packet->length == 0)
 202:UserAPP/Source/ReceiveDataProcess.c ****     {
 203:UserAPP/Source/ReceiveDataProcess.c ****         return;
 204:UserAPP/Source/ReceiveDataProcess.c ****     }
 205:UserAPP/Source/ReceiveDataProcess.c **** 
 206:UserAPP/Source/ReceiveDataProcess.c ****     uint16_t appendLen = packet->length;
 207:UserAPP/Source/ReceiveDataProcess.c ****     if ((uint32_t)rxStreamLen + appendLen > sizeof(rxStreamBuf))
 208:UserAPP/Source/ReceiveDataProcess.c ****     {
 209:UserAPP/Source/ReceiveDataProcess.c ****         rxStreamLen = 0;
 210:UserAPP/Source/ReceiveDataProcess.c ****     }
 211:UserAPP/Source/ReceiveDataProcess.c **** 
 212:UserAPP/Source/ReceiveDataProcess.c ****     if (appendLen > sizeof(rxStreamBuf))
 213:UserAPP/Source/ReceiveDataProcess.c ****     {
 214:UserAPP/Source/ReceiveDataProcess.c ****         appendLen = (uint16_t)sizeof(rxStreamBuf);
 215:UserAPP/Source/ReceiveDataProcess.c ****     }
 216:UserAPP/Source/ReceiveDataProcess.c **** 
 217:UserAPP/Source/ReceiveDataProcess.c ****     memcpy(&rxStreamBuf[rxStreamLen], packet->data, appendLen);
 218:UserAPP/Source/ReceiveDataProcess.c ****     rxStreamLen = (uint16_t)(rxStreamLen + appendLen);
 219:UserAPP/Source/ReceiveDataProcess.c **** 
 220:UserAPP/Source/ReceiveDataProcess.c ****     while (rxStreamLen >= 5)
 221:UserAPP/Source/ReceiveDataProcess.c ****     {
 222:UserAPP/Source/ReceiveDataProcess.c ****         uint16_t start = 0;
 223:UserAPP/Source/ReceiveDataProcess.c ****         while (start < rxStreamLen && rxStreamBuf[start] != 0xAA)
 224:UserAPP/Source/ReceiveDataProcess.c ****         {
 225:UserAPP/Source/ReceiveDataProcess.c ****             start++;
 226:UserAPP/Source/ReceiveDataProcess.c ****         }
 227:UserAPP/Source/ReceiveDataProcess.c **** 
 228:UserAPP/Source/ReceiveDataProcess.c ****         if (start > 0)
 229:UserAPP/Source/ReceiveDataProcess.c ****         {
 230:UserAPP/Source/ReceiveDataProcess.c ****             memmove(rxStreamBuf, &rxStreamBuf[start], rxStreamLen - start);
 231:UserAPP/Source/ReceiveDataProcess.c ****             rxStreamLen = (uint16_t)(rxStreamLen - start);
 232:UserAPP/Source/ReceiveDataProcess.c ****         }
