 220:UserAPP/Source/ReceiveDataProcess.c **** static void vParseReceivedDataStream(const ReceiveDataPacket_t *packet)
 221:UserAPP/Source/ReceiveDataProcess.c **** {
 222:UserAPP/Source/ReceiveDataProcess.c ****     if (packet == NULL || packet->length == 0)
 223:UserAPP/Source/ReceiveDataProcess.c ****     {
 224:UserAPP/Source/ReceiveDataProcess.c ****         return;
 225:UserAPP/Source/ReceiveDataProcess.c ****     }
 226:UserAPP/Source/ReceiveDataProcess.c **** 
 227:UserAPP/Source/ReceiveDataProcess.c ****     uint16_t appendLen = packet->length;
 228:UserAPP/Source/ReceiveDataProcess.c ****     if ((uint32_t)rxStreamLen + appendLen > sizeof(rxStreamBuf))
 229:UserAPP/Source/ReceiveDataProcess.c ****     {
 230:UserAPP/Source/ReceiveDataProcess.c ****         rxStreamLen = 0;
 231:UserAPP/Source/ReceiveDataProcess.c ****     }
 232:UserAPP/Source/ReceiveDataProcess.c **** 
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccY5cyCs.s 			page 6


 233:UserAPP/Source/ReceiveDataProcess.c ****     if (appendLen > sizeof(rxStreamBuf))
 234:UserAPP/Source/ReceiveDataProcess.c ****     {
 235:UserAPP/Source/ReceiveDataProcess.c ****         appendLen = (uint16_t)sizeof(rxStreamBuf);
 236:UserAPP/Source/ReceiveDataProcess.c ****     }
 237:UserAPP/Source/ReceiveDataProcess.c **** 
 238:UserAPP/Source/ReceiveDataProcess.c ****     memcpy(&rxStreamBuf[rxStreamLen], packet->data, appendLen);
 239:UserAPP/Source/ReceiveDataProcess.c ****     rxStreamLen = (uint16_t)(rxStreamLen + appendLen);
 240:UserAPP/Source/ReceiveDataProcess.c **** 
 241:UserAPP/Source/ReceiveDataProcess.c ****     while (rxStreamLen >= 5)
 242:UserAPP/Source/ReceiveDataProcess.c ****     {
 243:UserAPP/Source/ReceiveDataProcess.c ****         uint16_t start = 0;
 244:UserAPP/Source/ReceiveDataProcess.c ****         while (start < rxStreamLen && rxStreamBuf[start] != 0xAA)
 245:UserAPP/Source/ReceiveDataProcess.c ****         {
 246:UserAPP/Source/ReceiveDataProcess.c ****             start++;
 247:UserAPP/Source/ReceiveDataProcess.c ****         }
 248:UserAPP/Source/ReceiveDataProcess.c **** 
 249:UserAPP/Source/ReceiveDataProcess.c ****         if (start > 0)
 250:UserAPP/Source/ReceiveDataProcess.c ****         {
 251:UserAPP/Source/ReceiveDataProcess.c ****             memmove(rxStreamBuf, &rxStreamBuf[start], rxStreamLen - start);
 252:UserAPP/Source/ReceiveDataProcess.c ****             rxStreamLen = (uint16_t)(rxStreamLen - start);
 253:UserAPP/Source/ReceiveDataProcess.c ****         }
 254:UserAPP/Source/ReceiveDataProcess.c **** 
 255:UserAPP/Source/ReceiveDataProcess.c ****         if (rxStreamLen < 5)
 256:UserAPP/Source/ReceiveDataProcess.c ****         {
 257:UserAPP/Source/ReceiveDataProcess.c ****             break;
 258:UserAPP/Source/ReceiveDataProcess.c ****         }
 259:UserAPP/Source/ReceiveDataProcess.c **** 
 260:UserAPP/Source/ReceiveDataProcess.c ****         uint16_t frameLen = FindValidFrameLength(rxStreamBuf, rxStreamLen);
 261:UserAPP/Source/ReceiveDataProcess.c ****         if (frameLen == 0)
 262:UserAPP/Source/ReceiveDataProcess.c ****         {
 263:UserAPP/Source/ReceiveDataProcess.c ****             if (rxStreamLen > MAX_RECEIVE_DATA_SIZE)
 264:UserAPP/Source/ReceiveDataProcess.c ****             {
 265:UserAPP/Source/ReceiveDataProcess.c ****                 memmove(rxStreamBuf, &rxStreamBuf[1], rxStreamLen - 1);
 266:UserAPP/Source/ReceiveDataProcess.c ****                 rxStreamLen = (uint16_t)(rxStreamLen - 1);
 267:UserAPP/Source/ReceiveDataProcess.c ****                 continue;
 268:UserAPP/Source/ReceiveDataProcess.c ****             }
 269:UserAPP/Source/ReceiveDataProcess.c ****             break;
 270:UserAPP/Source/ReceiveDataProcess.c ****         }
 271:UserAPP/Source/ReceiveDataProcess.c **** 
 272:UserAPP/Source/ReceiveDataProcess.c ****         ReceiveDataPacket_t framePacket;
 273:UserAPP/Source/ReceiveDataProcess.c ****         memset(&framePacket, 0, sizeof(framePacket));
 274:UserAPP/Source/ReceiveDataProcess.c ****         framePacket.length = frameLen;
 275:UserAPP/Source/ReceiveDataProcess.c ****         memcpy(framePacket.data, rxStreamBuf, frameLen);
 276:UserAPP/Source/ReceiveDataProcess.c **** 
 277:UserAPP/Source/ReceiveDataProcess.c ****         vParseReceivedDataPacket(&framePacket);
 278:UserAPP/Source/ReceiveDataProcess.c **** 
 279:UserAPP/Source/ReceiveDataProcess.c ****         if (rxStreamLen > frameLen)
 280:UserAPP/Source/ReceiveDataProcess.c ****         {
 281:UserAPP/Source/ReceiveDataProcess.c ****             memmove(rxStreamBuf, &rxStreamBuf[frameLen], rxStreamLen - frameLen);
 282:UserAPP/Source/ReceiveDataProcess.c ****         }
 283:UserAPP/Source/ReceiveDataProcess.c ****         rxStreamLen = (uint16_t)(rxStreamLen - frameLen);
 284:UserAPP/Source/ReceiveDataProcess.c ****     }
 285:UserAPP/Source/ReceiveDataProcess.c **** }
