 133:UserAPP/Source/ReceiveDataProcess.c ****     uint32_t remaining = *Len;
 134:UserAPP/Source/ReceiveDataProcess.c **** 
 135:UserAPP/Source/ReceiveDataProcess.c ****     while (remaining > 0)
 136:UserAPP/Source/ReceiveDataProcess.c ****     {
 137:UserAPP/Source/ReceiveDataProcess.c ****         uint32_t chunkLen = (remaining > MAX_RECEIVE_DATA_SIZE) ? MAX_RECEIVE_DATA_SIZE : remaining
 138:UserAPP/Source/ReceiveDataProcess.c ****         BaseType_t localTaskWoken = pdFALSE;
 139:UserAPP/Source/ReceiveDataProcess.c ****         ReceiveDataPacket_t isrPacket;
 140:UserAPP/Source/ReceiveDataProcess.c **** 
 141:UserAPP/Source/ReceiveDataProcess.c ****         memset(&isrPacket, 0, sizeof(isrPacket));
 142:UserAPP/Source/ReceiveDataProcess.c ****         memcpy(isrPacket.data, &Buf[offset], chunkLen);
 143:UserAPP/Source/ReceiveDataProcess.c ****         isrPacket.length = (uint16_t)chunkLen;
 144:UserAPP/Source/ReceiveDataProcess.c **** 
 145:UserAPP/Source/ReceiveDataProcess.c ****         if (xQueueSendFromISR(xReceiveDataQueue, &isrPacket, &localTaskWoken) != pdPASS)
 146:UserAPP/Source/ReceiveDataProcess.c ****         {
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccY5cyCs.s 			page 4


 147:UserAPP/Source/ReceiveDataProcess.c ****             return 1;
 148:UserAPP/Source/ReceiveDataProcess.c ****         }
 149:UserAPP/Source/ReceiveDataProcess.c **** 
 150:UserAPP/Source/ReceiveDataProcess.c ****         if (localTaskWoken == pdTRUE)
 151:UserAPP/Source/ReceiveDataProcess.c ****         {
 152:UserAPP/Source/ReceiveDataProcess.c ****             xHigherPriorityTaskWoken = pdTRUE;
 153:UserAPP/Source/ReceiveDataProcess.c ****         }
 154:UserAPP/Source/ReceiveDataProcess.c **** 
 155:UserAPP/Source/ReceiveDataProcess.c ****         offset += chunkLen;
 156:UserAPP/Source/ReceiveDataProcess.c ****         remaining -= chunkLen;
 157:UserAPP/Source/ReceiveDataProcess.c ****     }
 158:UserAPP/Source/ReceiveDataProcess.c **** 
