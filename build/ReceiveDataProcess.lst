  42:UserAPP/Source/ReceiveDataProcess.c **** /**
  43:UserAPP/Source/ReceiveDataProcess.c ****  * @brief 接收数据处理任务
  44:UserAPP/Source/ReceiveDataProcess.c ****  *
  45:UserAPP/Source/ReceiveDataProcess.c ****  * 该任务负责从系统的接收通道（例如 UART、SPI、USB 等）获取原始数据，
  46:UserAPP/Source/ReceiveDataProcess.c ****  * 对数据进行必要的解析与校验，并将处理后的消息/事件分发到应用层。
  47:UserAPP/Source/ReceiveDataProcess.c ****  */
  48:UserAPP/Source/ReceiveDataProcess.c **** void vReceiveDataProcessTask( void * pvParameters )
  49:UserAPP/Source/ReceiveDataProcess.c **** {
  50:UserAPP/Source/ReceiveDataProcess.c ****     /* 该参数值期望为 1，因为在下面对 xTaskCreate() 的调用中将 1 作为 pvParame
  51:UserAPP/Source/ReceiveDataProcess.c ****     configASSERT( ( ( uint32_t ) pvParameters ) == 1 );
  52:UserAPP/Source/ReceiveDataProcess.c ****     
  53:UserAPP/Source/ReceiveDataProcess.c ****     for (;;)
  54:UserAPP/Source/ReceiveDataProcess.c ****     {
  55:UserAPP/Source/ReceiveDataProcess.c ****         if( xReceiveDataQueue != NULL )
  56:UserAPP/Source/ReceiveDataProcess.c ****         {
  57:UserAPP/Source/ReceiveDataProcess.c ****             /* 从已创建的队列接收一条消息 */
  58:UserAPP/Source/ReceiveDataProcess.c ****             if( xQueueReceive( xReceiveDataQueue, &(dataPacket),(TickType_t) 0 ) == pdPASS )
  59:UserAPP/Source/ReceiveDataProcess.c ****             {
  60:UserAPP/Source/ReceiveDataProcess.c ****                 /* xReceiveDataQueueRx now contains a copy of xMessage. */
  61:UserAPP/Source/ReceiveDataProcess.c ****                 
  62:UserAPP/Source/ReceiveDataProcess.c ****                 //打印接收到的原始数据（用于调试）
  63:UserAPP/Source/ReceiveDataProcess.c ****                 #if TEST_MODE 
  64:UserAPP/Source/ReceiveDataProcess.c ****                     char hexStr[256]; // 足够容纳所有数据的十六进制表示
  65:UserAPP/Source/ReceiveDataProcess.c ****                     int offset = 0;
  66:UserAPP/Source/ReceiveDataProcess.c ****                     
  67:UserAPP/Source/ReceiveDataProcess.c ****                     offset += sprintf(hexStr + offset, "接收到数据[%d字节]: ", dataPacket.le
  68:UserAPP/Source/ReceiveDataProcess.c ****                     
  69:UserAPP/Source/ReceiveDataProcess.c ****                     // 打印所有接收到的字节
  70:UserAPP/Source/ReceiveDataProcess.c ****                     for (uint16_t i = 0; i < dataPacket.length && i < MAX_RECEIVE_DATA_SIZE; i++)
  71:UserAPP/Source/ReceiveDataProcess.c ****                     {
  72:UserAPP/Source/ReceiveDataProcess.c ****                         offset += sprintf(hexStr + offset, "%02X ", dataPacket.data[i]);
  73:UserAPP/Source/ReceiveDataProcess.c ****                     }
  74:UserAPP/Source/ReceiveDataProcess.c ****                     
  75:UserAPP/Source/ReceiveDataProcess.c ****                     offset += sprintf(hexStr + offset, "\r\n");
  76:UserAPP/Source/ReceiveDataProcess.c ****                     
  77:UserAPP/Source/ReceiveDataProcess.c ****                     // 一次性发送完整的字符串到日志队列 
  78:UserAPP/Source/ReceiveDataProcess.c ****                     QueueSendfmt(xReceiveLogQueue, 0, "%s", hexStr);
  79:UserAPP/Source/ReceiveDataProcess.c ****                 #endif
  80:UserAPP/Source/ReceiveDataProcess.c ****                 
  81:UserAPP/Source/ReceiveDataProcess.c ****                 
  82:UserAPP/Source/ReceiveDataProcess.c ****                 /* 解析数据包 */
