 171:UserAPP/Source/ReceiveDataProcess.c **** static uint16_t FindValidFrameLength(const uint8_t *buf, uint16_t available)
 172:UserAPP/Source/ReceiveDataProcess.c **** {
 173:UserAPP/Source/ReceiveDataProcess.c ****     uint16_t maxTry;
 174:UserAPP/Source/ReceiveDataProcess.c **** 
 175:UserAPP/Source/ReceiveDataProcess.c ****     if (buf == NULL || available < 5)
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\ccY5cyCs.s 			page 5


 176:UserAPP/Source/ReceiveDataProcess.c ****     {
 177:UserAPP/Source/ReceiveDataProcess.c ****         return 0;
 178:UserAPP/Source/ReceiveDataProcess.c ****     }
 179:UserAPP/Source/ReceiveDataProcess.c **** 
 180:UserAPP/Source/ReceiveDataProcess.c ****     if (buf[0] != 0xAA)
 181:UserAPP/Source/ReceiveDataProcess.c ****     {
 182:UserAPP/Source/ReceiveDataProcess.c ****         return 0;
 183:UserAPP/Source/ReceiveDataProcess.c ****     }
 184:UserAPP/Source/ReceiveDataProcess.c **** 
 185:UserAPP/Source/ReceiveDataProcess.c ****     if (!IsHostRequestFunctionCode(buf[1]))
 186:UserAPP/Source/ReceiveDataProcess.c ****     {
 187:UserAPP/Source/ReceiveDataProcess.c ****         return 0;
 188:UserAPP/Source/ReceiveDataProcess.c ****     }
 189:UserAPP/Source/ReceiveDataProcess.c **** 
 190:UserAPP/Source/ReceiveDataProcess.c ****     maxTry = (available < MAX_RECEIVE_DATA_SIZE) ? available : MAX_RECEIVE_DATA_SIZE;
 191:UserAPP/Source/ReceiveDataProcess.c **** 
 192:UserAPP/Source/ReceiveDataProcess.c ****     if (buf[1] == FUNCTION_CODE_CommandPacket)
 193:UserAPP/Source/ReceiveDataProcess.c ****     {
 194:UserAPP/Source/ReceiveDataProcess.c ****         /* CommandPacket 固定包含 3 字节参数：Address/Wr/Number。 */
 195:UserAPP/Source/ReceiveDataProcess.c ****         if (maxTry < 8)
 196:UserAPP/Source/ReceiveDataProcess.c ****         {
 197:UserAPP/Source/ReceiveDataProcess.c ****             return 0;
 198:UserAPP/Source/ReceiveDataProcess.c ****         }
 199:UserAPP/Source/ReceiveDataProcess.c **** 
 200:UserAPP/Source/ReceiveDataProcess.c ****         if (CalculateCRC8(buf, 7) == buf[7])
 201:UserAPP/Source/ReceiveDataProcess.c ****         {
 202:UserAPP/Source/ReceiveDataProcess.c ****             return 8;
 203:UserAPP/Source/ReceiveDataProcess.c ****         }
 204:UserAPP/Source/ReceiveDataProcess.c **** 
 205:UserAPP/Source/ReceiveDataProcess.c ****         return 0;
 206:UserAPP/Source/ReceiveDataProcess.c ****     }
 207:UserAPP/Source/ReceiveDataProcess.c **** 
 208:UserAPP/Source/ReceiveDataProcess.c ****     for (uint16_t frameLen = 5; frameLen <= maxTry; frameLen++)
 209:UserAPP/Source/ReceiveDataProcess.c ****     {
 210:UserAPP/Source/ReceiveDataProcess.c ****         uint8_t crc = CalculateCRC8(buf, (uint16_t)(frameLen - 1));
 211:UserAPP/Source/ReceiveDataProcess.c ****         if (crc == buf[frameLen - 1])
 212:UserAPP/Source/ReceiveDataProcess.c ****         {
 213:UserAPP/Source/ReceiveDataProcess.c ****             return frameLen;
 214:UserAPP/Source/ReceiveDataProcess.c ****         }
 215:UserAPP/Source/ReceiveDataProcess.c ****     }
 216:UserAPP/Source/ReceiveDataProcess.c **** 
 217:UserAPP/Source/ReceiveDataProcess.c ****     return 0;
 218:UserAPP/Source/ReceiveDataProcess.c **** }
