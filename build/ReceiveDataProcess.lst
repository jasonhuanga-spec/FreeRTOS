  91:UserAPP/Source/ReceiveDataProcess.c **** /**
  92:UserAPP/Source/ReceiveDataProcess.c ****  * @brief 示例任务：创建一个队列用于接收数据
  93:UserAPP/Source/ReceiveDataProcess.c **** 
  94:UserAPP/Source/ReceiveDataProcess.c ****  *
  95:UserAPP/Source/ReceiveDataProcess.c ****  * 该任务创建一个队列以存储接收到的数据。实际应用中
  96:UserAPP/Source/ReceiveDataProcess.c ****  * 任务应包含从外设接收数据并将其发送到队列的逻辑
  97:UserAPP/Source/ReceiveDataProcess.c ****  */
  98:UserAPP/Source/ReceiveDataProcess.c **** void vCreateReceiveDataQueueTask( void *pvParameters )
  99:UserAPP/Source/ReceiveDataProcess.c **** {
 100:UserAPP/Source/ReceiveDataProcess.c ****     /* 创建一个用于保存接收数据包（ReceiveDataPacket_t）的队列，最多可容纳 
 101:UserAPP/Source/ReceiveDataProcess.c ****     xReceiveDataQueue = xQueueCreate( 25, sizeof(ReceiveDataPacket_t) );
 102:UserAPP/Source/ReceiveDataProcess.c **** 
 103:UserAPP/Source/ReceiveDataProcess.c ****     if( xReceiveDataQueue == NULL )
 104:UserAPP/Source/ReceiveDataProcess.c ****     {
 105:UserAPP/Source/ReceiveDataProcess.c ****         /* Queue was not created and must not be used. */
 106:UserAPP/Source/ReceiveDataProcess.c ****     }
 107:UserAPP/Source/ReceiveDataProcess.c ****  }
