  32:UserAPP/Source/SendDataProcess.c **** /**
ARM GAS  C:\Users\Administrator\AppData\Local\Temp\cccDmnZi.s 			page 2


  33:UserAPP/Source/SendDataProcess.c ****  * @brief 发送数据任务：从队列取数据并串行调用 CDC_Transmit_FS
  34:UserAPP/Source/SendDataProcess.c ****  */
  35:UserAPP/Source/SendDataProcess.c **** void vSendDataProcessTask(void *pvParameters)
  36:UserAPP/Source/SendDataProcess.c **** {
  37:UserAPP/Source/SendDataProcess.c ****     configASSERT(((uint32_t)pvParameters) == 1);
  38:UserAPP/Source/SendDataProcess.c **** 
  39:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
  40:UserAPP/Source/SendDataProcess.c **** 
  41:UserAPP/Source/SendDataProcess.c ****     for (;;)
  42:UserAPP/Source/SendDataProcess.c ****     {
  43:UserAPP/Source/SendDataProcess.c ****         if (xSendDataQueue != NULL)
  44:UserAPP/Source/SendDataProcess.c ****         {
  45:UserAPP/Source/SendDataProcess.c ****             if (xQueueReceive(xSendDataQueue, &item, portMAX_DELAY) == pdPASS)
  46:UserAPP/Source/SendDataProcess.c ****             {
  47:UserAPP/Source/SendDataProcess.c ****                 /* 等待 USB 空闲再发送，避免并发 BUSY */
  48:UserAPP/Source/SendDataProcess.c ****                 for (int attempt = 0; attempt < 5; ++attempt)
  49:UserAPP/Source/SendDataProcess.c ****                 {
  50:UserAPP/Source/SendDataProcess.c ****                     uint32_t waitLoops = 0;
  51:UserAPP/Source/SendDataProcess.c ****                     while (USBD_CDC_GetTxState() != 0 && waitLoops < 40)
  52:UserAPP/Source/SendDataProcess.c ****                     {
  53:UserAPP/Source/SendDataProcess.c ****                         vTaskDelay(pdMS_TO_TICKS(5));
  54:UserAPP/Source/SendDataProcess.c ****                         waitLoops++;
  55:UserAPP/Source/SendDataProcess.c ****                     }
  56:UserAPP/Source/SendDataProcess.c **** 
  57:UserAPP/Source/SendDataProcess.c ****                     if (USBD_CDC_GetTxState() != 0)
  58:UserAPP/Source/SendDataProcess.c ****                     {
  59:UserAPP/Source/SendDataProcess.c ****                         continue; // 继续下一次尝试
  60:UserAPP/Source/SendDataProcess.c ****                     }
  61:UserAPP/Source/SendDataProcess.c **** 
  62:UserAPP/Source/SendDataProcess.c ****                     uint8_t txRet = CDC_Transmit_FS(item.buf, item.len);
  63:UserAPP/Source/SendDataProcess.c ****                     if (txRet == USBD_OK)
  64:UserAPP/Source/SendDataProcess.c ****                     {
  65:UserAPP/Source/SendDataProcess.c ****                         break; // 发送成功
  66:UserAPP/Source/SendDataProcess.c ****                     }
  67:UserAPP/Source/SendDataProcess.c **** 
  68:UserAPP/Source/SendDataProcess.c ****                     vTaskDelay(pdMS_TO_TICKS(5)); // 短暂等待再试
  69:UserAPP/Source/SendDataProcess.c ****                 }
  70:UserAPP/Source/SendDataProcess.c ****             }
  71:UserAPP/Source/SendDataProcess.c ****         }
  72:UserAPP/Source/SendDataProcess.c ****     }
  73:UserAPP/Source/SendDataProcess.c **** }
  74:UserAPP/Source/SendDataProcess.c **** 
