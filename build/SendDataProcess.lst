  37:UserAPP/Source/SendDataProcess.c **** /**
  38:UserAPP/Source/SendDataProcess.c ****  * @brief 接收数据处理任务
  39:UserAPP/Source/SendDataProcess.c ****  *
  40:UserAPP/Source/SendDataProcess.c ****  * 该任务负责从系统的接收通道（例如 UART、SPI、USB 等）获取原始数据，
  41:UserAPP/Source/SendDataProcess.c ****  * 对数据进行必要的解析与校验，并将处理后的消息/事件分发到应用层。
  42:UserAPP/Source/SendDataProcess.c ****  */
  43:UserAPP/Source/SendDataProcess.c **** void vSendLogProcessTask( void * pvParameters )
  44:UserAPP/Source/SendDataProcess.c **** {
