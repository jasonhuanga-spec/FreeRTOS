  49:UserAPP/Source/SendDataProcess.c ****     {
  50:UserAPP/Source/SendDataProcess.c ****         //放到循环中，不停更新这个数组
  51:UserAPP/Source/SendDataProcess.c ****         char xReceiveLogQueueBuf[PRINT_QUEUE_ITEM_SIZE];
  52:UserAPP/Source/SendDataProcess.c **** 
  53:UserAPP/Source/SendDataProcess.c ****         if( xReceiveLogQueue != NULL )
  54:UserAPP/Source/SendDataProcess.c ****             {
