 110:UserAPP/Source/SendDataProcess.c **** /**
 111:UserAPP/Source/SendDataProcess.c ****  * @brief 将二进制数据入统一发送队列
 112:UserAPP/Source/SendDataProcess.c ****  */
 113:UserAPP/Source/SendDataProcess.c **** BaseType_t SendBinaryToHost(const uint8_t *data, uint16_t len, TickType_t xTicksToWait)
 114:UserAPP/Source/SendDataProcess.c **** {
 115:UserAPP/Source/SendDataProcess.c ****     if (xSendDataQueue == NULL || data == NULL || len == 0) {
 116:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
 117:UserAPP/Source/SendDataProcess.c ****     }
 118:UserAPP/Source/SendDataProcess.c **** 
 119:UserAPP/Source/SendDataProcess.c ****     if (len > PRINT_QUEUE_ITEM_SIZE) {
 120:UserAPP/Source/SendDataProcess.c ****         return pdFAIL; // 数据过长，避免溢出
 121:UserAPP/Source/SendDataProcess.c ****     }
 122:UserAPP/Source/SendDataProcess.c **** 
 123:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
 124:UserAPP/Source/SendDataProcess.c ****     item.len = len;
 125:UserAPP/Source/SendDataProcess.c ****     memcpy(item.buf, data, len);
 126:UserAPP/Source/SendDataProcess.c **** 
 127:UserAPP/Source/SendDataProcess.c ****     return xQueueSend(xSendDataQueue, &item, xTicksToWait);
 128:UserAPP/Source/SendDataProcess.c **** }
