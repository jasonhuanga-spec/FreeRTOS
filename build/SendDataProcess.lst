  91:UserAPP/Source/SendDataProcess.c **** /**
  92:UserAPP/Source/SendDataProcess.c ****  * @brief 将二进制数据入统一发送队列
  93:UserAPP/Source/SendDataProcess.c ****  */
  94:UserAPP/Source/SendDataProcess.c **** BaseType_t SendBinaryToHost(const uint8_t *data, uint16_t len, TickType_t xTicksToWait)
  95:UserAPP/Source/SendDataProcess.c **** {
  96:UserAPP/Source/SendDataProcess.c ****     if (xSendDataQueue == NULL || data == NULL || len == 0) {
  97:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
  98:UserAPP/Source/SendDataProcess.c ****     }
  99:UserAPP/Source/SendDataProcess.c **** 
 100:UserAPP/Source/SendDataProcess.c ****     if (len > PRINT_QUEUE_ITEM_SIZE) {
 101:UserAPP/Source/SendDataProcess.c ****         return pdFAIL; // 数据过长，避免溢出
 102:UserAPP/Source/SendDataProcess.c ****     }
 103:UserAPP/Source/SendDataProcess.c **** 
 104:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
 105:UserAPP/Source/SendDataProcess.c ****     item.len = len;
 106:UserAPP/Source/SendDataProcess.c ****     memcpy(item.buf, data, len);
 107:UserAPP/Source/SendDataProcess.c **** 
 108:UserAPP/Source/SendDataProcess.c ****     return xQueueSend(xSendDataQueue, &item, xTicksToWait);
 109:UserAPP/Source/SendDataProcess.c **** }
 110:UserAPP/Source/SendDataProcess.c **** 
 111:UserAPP/Source/SendDataProcess.c **** /**
 112:UserAPP/Source/SendDataProcess.c ****  * @brief 将应答类二进制数据优先入发送队列（入队到队列头部）
 113:UserAPP/Source/SendDataProcess.c ****  */
 114:UserAPP/Source/SendDataProcess.c **** BaseType_t SendBinaryToHostFront(const uint8_t *data, uint16_t len, TickType_t xTicksToWait)
 115:UserAPP/Source/SendDataProcess.c **** {
 116:UserAPP/Source/SendDataProcess.c ****     if (xSendDataQueue == NULL || data == NULL || len == 0) {
 117:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
 118:UserAPP/Source/SendDataProcess.c ****     }
 119:UserAPP/Source/SendDataProcess.c **** 
 120:UserAPP/Source/SendDataProcess.c ****     if (len > PRINT_QUEUE_ITEM_SIZE) {
 121:UserAPP/Source/SendDataProcess.c ****         return pdFAIL; // 数据过长，避免溢出
 122:UserAPP/Source/SendDataProcess.c ****     }
 123:UserAPP/Source/SendDataProcess.c **** 
 124:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
 125:UserAPP/Source/SendDataProcess.c ****     item.len = len;
 126:UserAPP/Source/SendDataProcess.c ****     memcpy(item.buf, data, len);
 127:UserAPP/Source/SendDataProcess.c **** 
 128:UserAPP/Source/SendDataProcess.c ****     return xQueueSendToFront(xSendDataQueue, &item, xTicksToWait);
 129:UserAPP/Source/SendDataProcess.c **** }
