  91:UserAPP/Source/SendDataProcess.c ****  /** * @brief 格式化字符串并发送到队列
  92:UserAPP/Source/SendDataProcess.c ****  *  * 
  93:UserAPP/Source/SendDataProcess.c ****   * @param xQueue 队列句柄
  94:UserAPP/Source/SendDataProcess.c ****   * @param xTicksToWait 等待时间
  95:UserAPP/Source/SendDataProcess.c ****   * @param fmt 格式化字符串
  96:UserAPP/Source/SendDataProcess.c ****   * @param ... 可变参数
  97:UserAPP/Source/SendDataProcess.c ****   * @return BaseType_t 发送结果
  98:UserAPP/Source/SendDataProcess.c ****   * 
  99:UserAPP/Source/SendDataProcess.c ****   * // 无等待（不允许阻塞）
 100:UserAPP/Source/SendDataProcess.c ****     QueueSendfmt(xPrintQueue, 0, "接收到数据: %02X", parsedDataPacket.Payload[0]);
 101:UserAPP/Source/SendDataProcess.c ****   */                    
 102:UserAPP/Source/SendDataProcess.c **** BaseType_t QueueSendfmt(QueueHandle_t xQueue, TickType_t xTicksToWait, const char *fmt, ...)
 103:UserAPP/Source/SendDataProcess.c **** {
 104:UserAPP/Source/SendDataProcess.c ****     if (xQueue == NULL || fmt == NULL) {
 105:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
 106:UserAPP/Source/SendDataProcess.c ****     }
 107:UserAPP/Source/SendDataProcess.c **** 
 108:UserAPP/Source/SendDataProcess.c ****     char buf[PRINT_QUEUE_ITEM_SIZE];
 109:UserAPP/Source/SendDataProcess.c ****     memset(buf, 0, sizeof(buf));
 110:UserAPP/Source/SendDataProcess.c **** 
 111:UserAPP/Source/SendDataProcess.c ****     va_list ap;
 112:UserAPP/Source/SendDataProcess.c ****     va_start(ap, fmt);
 113:UserAPP/Source/SendDataProcess.c ****     vsnprintf(buf, sizeof(buf), fmt, ap);
 114:UserAPP/Source/SendDataProcess.c ****     va_end(ap);
 115:UserAPP/Source/SendDataProcess.c **** 
 116:UserAPP/Source/SendDataProcess.c ****     return xQueueSend(xQueue, buf, xTicksToWait);
 117:UserAPP/Source/SendDataProcess.c **** }
