  59:UserAPP/Source/SendDataProcess.c ****                     int actual_len = strlen(xReceiveLogQueueBuf);
  60:UserAPP/Source/SendDataProcess.c ****                     
  61:UserAPP/Source/SendDataProcess.c ****                     /* 只发送实际的字符串内容，而不是整个缓冲区 */
  62:UserAPP/Source/SendDataProcess.c ****                     if( actual_len > 0 )    CDC_Transmit_FS((uint8_t*)xReceiveLogQueueBuf, actual_l
  63:UserAPP/Source/SendDataProcess.c **** 
