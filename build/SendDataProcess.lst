 103:UserAPP/Source/SendDataProcess.c ****     }
 104:UserAPP/Source/SendDataProcess.c **** 
 105:UserAPP/Source/SendDataProcess.c ****     item.len = (len > (int)sizeof(item.buf)) ? (uint16_t)sizeof(item.buf) : (uint16_t)len;
 106:UserAPP/Source/SendDataProcess.c **** 
 107:UserAPP/Source/SendDataProcess.c ****     return xQueueSend(xQueue, &item, xTicksToWait);
