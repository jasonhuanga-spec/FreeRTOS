  90:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
  91:UserAPP/Source/SendDataProcess.c ****     }
  92:UserAPP/Source/SendDataProcess.c **** 
  93:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
  94:UserAPP/Source/SendDataProcess.c ****     memset(&item, 0, sizeof(item));
  95:UserAPP/Source/SendDataProcess.c **** 
  96:UserAPP/Source/SendDataProcess.c ****     va_list ap;
  97:UserAPP/Source/SendDataProcess.c ****     va_start(ap, fmt);
  98:UserAPP/Source/SendDataProcess.c ****     int len = vsnprintf((char*)item.buf, sizeof(item.buf), fmt, ap);
  99:UserAPP/Source/SendDataProcess.c ****     va_end(ap);
