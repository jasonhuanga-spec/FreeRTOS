  34:UserAPP/Source/SendDataProcess.c **** /**
  35:UserAPP/Source/SendDataProcess.c ****  * @brief 发送数据任务：从队列取数据并串行调用 CDC_Transmit_FS
  36:UserAPP/Source/SendDataProcess.c ****  */
  37:UserAPP/Source/SendDataProcess.c **** void vSendDataProcessTask(void *pvParameters)
  38:UserAPP/Source/SendDataProcess.c **** {
  39:UserAPP/Source/SendDataProcess.c ****     configASSERT(((uint32_t)pvParameters) == 1);
  40:UserAPP/Source/SendDataProcess.c **** 
  41:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
  42:UserAPP/Source/SendDataProcess.c **** 
  43:UserAPP/Source/SendDataProcess.c ****     for (;;)
  44:UserAPP/Source/SendDataProcess.c ****     {
  45:UserAPP/Source/SendDataProcess.c ****         if (xSendDataQueue != NULL)
  46:UserAPP/Source/SendDataProcess.c ****         {
  47:UserAPP/Source/SendDataProcess.c ****             if (xQueueReceive(xSendDataQueue, &item, portMAX_DELAY) == pdPASS)
  48:UserAPP/Source/SendDataProcess.c ****             {
  49:UserAPP/Source/SendDataProcess.c ****                 /* 发送至串口 USART1 */
  50:UserAPP/Source/SendDataProcess.c ****                 UART1_SendBlocking(item.buf, item.len);
  51:UserAPP/Source/SendDataProcess.c ****             }
  52:UserAPP/Source/SendDataProcess.c ****         }
  53:UserAPP/Source/SendDataProcess.c ****     }
  54:UserAPP/Source/SendDataProcess.c **** }
  55:UserAPP/Source/SendDataProcess.c **** 
  56:UserAPP/Source/SendDataProcess.c **** /**
  57:UserAPP/Source/SendDataProcess.c ****  * @brief 创建待发送数据队列
  58:UserAPP/Source/SendDataProcess.c ****  */
  59:UserAPP/Source/SendDataProcess.c **** void vCreateSendDataQueueTask(void *pvParameters)
  60:UserAPP/Source/SendDataProcess.c **** {
  61:UserAPP/Source/SendDataProcess.c ****     (void)pvParameters;
  62:UserAPP/Source/SendDataProcess.c ****     xSendDataQueue = xQueueCreate(20, sizeof(SendDataItem_t));
  63:UserAPP/Source/SendDataProcess.c **** }
  64:UserAPP/Source/SendDataProcess.c **** 
  65:UserAPP/Source/SendDataProcess.c **** /**
  66:UserAPP/Source/SendDataProcess.c ****  * @brief 格式化字符串并入统一发送队列
  67:UserAPP/Source/SendDataProcess.c ****  */
  68:UserAPP/Source/SendDataProcess.c **** BaseType_t QueueSendfmt(QueueHandle_t xQueue, TickType_t xTicksToWait, const char *fmt, ...)
  69:UserAPP/Source/SendDataProcess.c **** {
  70:UserAPP/Source/SendDataProcess.c ****     if (xQueue == NULL || fmt == NULL) {
  71:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
  72:UserAPP/Source/SendDataProcess.c ****     }
  73:UserAPP/Source/SendDataProcess.c **** 
  74:UserAPP/Source/SendDataProcess.c ****     SendDataItem_t item;
  75:UserAPP/Source/SendDataProcess.c ****     memset(&item, 0, sizeof(item));
  76:UserAPP/Source/SendDataProcess.c **** 
  77:UserAPP/Source/SendDataProcess.c ****     va_list ap;
  78:UserAPP/Source/SendDataProcess.c ****     va_start(ap, fmt);
  79:UserAPP/Source/SendDataProcess.c ****     int len = vsnprintf((char*)item.buf, sizeof(item.buf), fmt, ap);
  80:UserAPP/Source/SendDataProcess.c ****     va_end(ap);
  81:UserAPP/Source/SendDataProcess.c **** 
  82:UserAPP/Source/SendDataProcess.c ****     if (len <= 0) {
  83:UserAPP/Source/SendDataProcess.c ****         return pdFAIL;
  84:UserAPP/Source/SendDataProcess.c ****     }
  85:UserAPP/Source/SendDataProcess.c **** 
  86:UserAPP/Source/SendDataProcess.c ****     item.len = (len > (int)sizeof(item.buf)) ? (uint16_t)sizeof(item.buf) : (uint16_t)len;
  87:UserAPP/Source/SendDataProcess.c **** 
  88:UserAPP/Source/SendDataProcess.c ****     return xQueueSend(xQueue, &item, xTicksToWait);
  89:UserAPP/Source/SendDataProcess.c **** }
